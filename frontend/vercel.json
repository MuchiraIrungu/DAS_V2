{
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://das-v2.onrender.com/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://das-v2.onrender.com/api/:path*/"
    },
    {
      "source": "/admin/",
      "destination": "https://das-v2.onrender.com/admin/"
    },
    {
      "source": "/admin/:path*/",
      "destination": "https://das-v2.onrender.com/admin/:path*/"
    }
  ]
}